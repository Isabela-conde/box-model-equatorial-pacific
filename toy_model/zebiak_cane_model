module ZebiakCane1987

using LinearAlgebra
using Statistics
using Printf
using JLD2
using CairoMakie

const day  = 86400.0
const year = 365day

struct Grid
    Nx::Int
    Ny::Int
    Lx::Float64
    Ly::Float64
    dx::Float64
    dy::Float64
    x::Vector{Float64}
    y::Vector{Float64}
end

function make_grid(; Nx=121, Ny=41, Lx=1.6e7, Ly=4.4e6)
    x = collect(range(0, Lx, length=Nx))
    y = collect(range(-Ly/2, Ly/2, length=Ny))
    return Grid(Nx, Ny, Lx, Ly, x[2]-x[1], y[2]-y[1], x, y)
end

Base.@kwdef struct Params
    β::Float64      = 2.28e-11

    cₐ::Float64     = 60.0
    εₐ::Float64     = 1 / (2day)
    αQ::Float64     = 0.031

    H₁::Float64     = 50.0
    g′::Float64     = 0.03

    ro::Float64     = 1 / (120day)
    rh::Float64     = 1 / (120day)
    rs::Float64     = 1 / (45day)

    Aₘ::Float64     = 3000.0
    Aₕ::Float64     = 3000.0
    Aₜ::Float64     = 5000.0

    τscale::Float64 = 1.0e-12

    T₁::Float64     = 12.0
    T₂::Float64     = -12.0
    b₁::Float64     = 1 / 80.0
    b₂::Float64     = 1 / 33.0

    feedback_timescale::Float64 = 1500day
    max_T::Float64 = 8.0
    max_h::Float64 = 80.0
end

mutable struct State
    T::Matrix{Float64}
    h::Matrix{Float64}
    u::Matrix{Float64}
    v::Matrix{Float64}
    ua::Matrix{Float64}
    va::Matrix{Float64}
    pa::Matrix{Float64}
end

function initialise_state(grid)
    T  = zeros(grid.Nx, grid.Ny)
    h  = zeros(grid.Nx, grid.Ny)
    u  = zeros(grid.Nx, grid.Ny)
    v  = zeros(grid.Nx, grid.Ny)
    ua = zeros(grid.Nx, grid.Ny)
    va = zeros(grid.Nx, grid.Ny)
    pa = zeros(grid.Nx, grid.Ny)

    for i in 1:grid.Nx, j in 1:grid.Ny
        xnorm = grid.x[i] / grid.Lx
        ydeg  = grid.y[j] / 111e3

        T[i, j] = 0.2 *
                  exp(-((xnorm - 0.65) / 0.12)^2) *
                  exp(-(ydeg / 5)^2)
    end

    return State(T, h, u, v, ua, va, pa)
end

function ddx(A, grid)
    B = similar(A)

    for j in 1:grid.Ny
        B[1, j] = (A[2, j] - A[1, j]) / grid.dx
        B[end, j] = (A[end, j] - A[end-1, j]) / grid.dx

        for i in 2:grid.Nx-1
            B[i, j] = (A[i+1, j] - A[i-1, j]) / (2 * grid.dx)
        end
    end

    return B
end

function ddy(A, grid)
    B = similar(A)

    for i in 1:grid.Nx
        B[i, 1] = (A[i, 2] - A[i, 1]) / grid.dy
        B[i, end] = (A[i, end] - A[i, end-1]) / grid.dy

        for j in 2:grid.Ny-1
            B[i, j] = (A[i, j+1] - A[i, j-1]) / (2 * grid.dy)
        end
    end

    return B
end

function laplacian(A, grid)
    B = zeros(size(A))

    for i in 2:grid.Nx-1, j in 2:grid.Ny-1
        B[i, j] =
            (A[i+1, j] - 2A[i, j] + A[i-1, j]) / grid.dx^2 +
            (A[i, j+1] - 2A[i, j] + A[i, j-1]) / grid.dy^2
    end

    B[1, :]   .= B[2, :]
    B[end, :] .= B[end-1, :]
    B[:, 1]   .= B[:, 2]
    B[:, end] .= B[:, end-1]

    return B
end

function enforce_boundaries!(A)
    A[1, :]   .= A[2, :]
    A[end, :] .= A[end-1, :]
    A[:, 1]   .= A[:, 2]
    A[:, end] .= A[:, end-1]
end

M(x) = max(x, 0.0)

function mean_temperature(grid, t)
    Tbar = zeros(grid.Nx, grid.Ny)

    for i in 1:grid.Nx, j in 1:grid.Ny
        xnorm = grid.x[i] / grid.Lx
        ydeg  = grid.y[j] / 111e3

        Tbar[i, j] =
            29.0 -
            3.0 * xnorm -
            0.05 * ydeg^2
    end

    return Tbar
end

function mean_currents(grid, t)
    U = zeros(grid.Nx, grid.Ny)
    V = zeros(grid.Nx, grid.Ny)
    W = zeros(grid.Nx, grid.Ny)

    for i in 1:grid.Nx, j in 1:grid.Ny
        xnorm = grid.x[i] / grid.Lx
        ydeg  = grid.y[j] / 111e3

        eq = exp(-(ydeg / 4)^2)

        U[i, j] = -0.02 * eq
        V[i, j] = 0.0
        W[i, j] = 1.0e-8 * eq * exp(-((xnorm - 0.75) / 0.25)^2)
    end

    return U, V, W
end

function atmosphere_heating(T, grid, p)
    Q = similar(T)

    for i in 1:grid.Nx, j in 1:grid.Ny
        xnorm = grid.x[i] / grid.Lx
        ydeg  = grid.y[j] / 111e3

        conv_mask =
            exp(-((xnorm - 0.45) / 0.35)^2) *
            exp(-(ydeg / 8)^2)

        Q[i, j] = p.αQ * T[i, j] * conv_mask
    end

    return Q
end

function solve_atmosphere!(s, grid, p)
    Q = atmosphere_heating(s.T, grid, p)

    for i in 1:grid.Nx, j in 1:grid.Ny
        xnorm = grid.x[i] / grid.Lx
        ydeg  = grid.y[j] / 111e3

        eq_weight   = exp(-(ydeg / 8)^2)
        west_weight = exp(-((xnorm - 0.45) / 0.30)^2)

        s.ua[i, j] = 0.7 * Q[i, j] * west_weight * eq_weight
        s.va[i, j] = 0.0
        s.pa[i, j] = -Q[i, j] / p.εₐ
    end

    enforce_boundaries!(s.ua)
    enforce_boundaries!(s.va)
    enforce_boundaries!(s.pa)
end

function wind_stress(s, grid, p)
    τx = p.τscale .* s.ua
    τy = p.τscale .* s.va
    return τx, τy
end

function sponge_mask(grid)
    mask = ones(grid.Nx, grid.Ny)

    sponge_x = 0.08 * grid.Lx
    sponge_y = 0.08 * grid.Ly

    for i in 1:grid.Nx, j in 1:grid.Ny
        x = grid.x[i]
        y = grid.y[j]

        west  = x < sponge_x ? x / sponge_x : 1.0
        east  = x > grid.Lx - sponge_x ? (grid.Lx - x) / sponge_x : 1.0
        south = y < -grid.Ly/2 + sponge_y ? (y + grid.Ly/2) / sponge_y : 1.0
        north = y >  grid.Ly/2 - sponge_y ? (grid.Ly/2 - y) / sponge_y : 1.0

        mask[i, j] = min(west, east, south, north)^2
    end

    return mask
end

function update_ocean!(s, grid, p, dt, mask)
    hx = ddx(s.h, grid)
    hy = ddy(s.h, grid)

    τx, τy = wind_stress(s, grid, p)

    ∇²u = laplacian(s.u, grid)
    ∇²v = laplacian(s.v, grid)

    du = similar(s.u)
    dv = similar(s.v)

    for i in 1:grid.Nx, j in 1:grid.Ny
        f = p.β * grid.y[j]

        du[i, j] =
            f * s.v[i, j] -
            p.g′ * hx[i, j] +
            τx[i, j] / p.H₁ -
            p.ro * s.u[i, j] +
            p.Aₘ * ∇²u[i, j]

        dv[i, j] =
           -f * s.u[i, j] -
            p.g′ * hy[i, j] +
            τy[i, j] / p.H₁ -
            p.ro * s.v[i, j] +
            p.Aₘ * ∇²v[i, j]
    end

    s.u .+= dt .* du
    s.v .+= dt .* dv

    divu = ddx(s.u, grid) + ddy(s.v, grid)

    s.h .+= dt .* (
        -p.H₁ .* divu
        .- p.rh .* s.h
        .+ p.Aₕ .* laplacian(s.h, grid)
    )

    s.u .*= mask
    s.v .*= mask
    s.h .*= mask

    s.h .= clamp.(s.h, -p.max_h, p.max_h)

    enforce_boundaries!(s.u)
    enforce_boundaries!(s.v)
    enforce_boundaries!(s.h)
end

function thermocline_temperature(h, p)
    Tsub = similar(h)

    for I in eachindex(h)
        if h[I] >= 0
            Tsub[I] = p.T₁ * (tanh(p.b₁ * h[I] + p.b₂) - tanh(p.b₂))
        else
            Tsub[I] = p.T₂ * (tanh(p.b₁ * h[I] + p.b₂) - tanh(p.b₂))
        end
    end

    return Tsub
end

function update_sst!(s, grid, p, dt, t)
    Tbar = mean_temperature(grid, t)
    Ubar, Vbar, Wbar = mean_currents(grid, t)

    Tbar_x = ddx(Tbar, grid)
    Tbar_y = ddy(Tbar, grid)

    Tx = ddx(s.T, grid)
    Ty = ddy(s.T, grid)

    Tsub = thermocline_temperature(s.h, p)

    ∇²T = laplacian(s.T, grid)
    dT = similar(s.T)

    for i in 1:grid.Nx, j in 1:grid.Ny
        xnorm = grid.x[i] / grid.Lx
        ydeg  = grid.y[j] / 111e3

        eq_weight   = exp(-(ydeg / 5)^2)
        east_weight = exp(-((xnorm - 0.75) / 0.25)^2)

        thermocline_feedback =
            east_weight * eq_weight * Tsub[i, j] / p.feedback_timescale

        mean_upwelling_damping =
            M(Wbar[i, j]) * s.T[i, j] / p.H₁

        dT[i, j] =
            -0.05 * s.u[i, j] * Tbar_x[i, j] -
             0.05 * s.v[i, j] * Tbar_y[i, j] -
             Ubar[i, j] * Tx[i, j] -
             Vbar[i, j] * Ty[i, j] +
             thermocline_feedback -
             mean_upwelling_damping -
             p.rs * s.T[i, j] +
             p.Aₜ * ∇²T[i, j]
    end

    s.T .+= dt .* dT

    s.T .= clamp.(s.T, -p.max_T, p.max_T)

    enforce_boundaries!(s.T)
end

function check_state(s, t)
    if any(!isfinite, s.T) || any(!isfinite, s.h) ||
       any(!isfinite, s.u) || any(!isfinite, s.v) ||
       any(!isfinite, s.ua) || any(!isfinite, s.va)
        error("Non-finite value at year = $(t / year)")
    end
end

function region_mean(A, grid; xbounds=(0.0, grid.Lx), ybounds=(-grid.Ly/2, grid.Ly/2))
    ix = findall(x -> xbounds[1] <= x <= xbounds[2], grid.x)
    iy = findall(y -> ybounds[1] <= y <= ybounds[2], grid.y)
    return mean(A[ix, iy])
end

function nino3_mean(T, grid)
    return region_mean(T, grid;
        xbounds=(0.55 * grid.Lx, 0.90 * grid.Lx),
        ybounds=(-5 * 111e3, 5 * 111e3))
end

function nino34_mean(T, grid)
    return region_mean(T, grid;
        xbounds=(0.45 * grid.Lx, 0.75 * grid.Lx),
        ybounds=(-5 * 111e3, 5 * 111e3))
end

function run_model(; stop_time=5year,
                    dt=0.05day,
                    output_interval=30day,
                    output_file="zebiak_cane_1987.jld2")

    grid = make_grid()
    p = Params()
    s = initialise_state(grid)
    mask = sponge_mask(grid)

    nt = Int(round(stop_time / dt))
    nout = Int(round(output_interval / dt))

    times = Float64[]
    nino3 = Float64[]
    nino34 = Float64[]
    basin = Float64[]

    Tsave = Matrix{Float64}[]
    hsave = Matrix{Float64}[]

    for n in 1:nt
        t = n * dt

        solve_atmosphere!(s, grid, p)
        update_ocean!(s, grid, p, dt, mask)
        update_sst!(s, grid, p, dt, t)

        check_state(s, t)

        if n % nout == 0
            push!(times, t / year)
            push!(nino3, nino3_mean(s.T, grid))
            push!(nino34, nino34_mean(s.T, grid))
            push!(basin, mean(s.T))

            push!(Tsave, copy(s.T))
            push!(hsave, copy(s.h))

            n_clipped_T = count(abs.(s.T) .>= p.max_T)
            n_clipped_h = count(abs.(s.h) .>= p.max_h)

            @printf("year = %.2f, NINO3 = %.3f °C, NINO3.4 = %.3f °C, max |h| = %.2f m, max |T| = %.2f °C, clipped T = %d, clipped h = %d\n",
                    t / year, nino3[end], nino34[end],
                    maximum(abs, s.h), maximum(abs, s.T),
                    n_clipped_T, n_clipped_h)
        end
    end

    jldsave(output_file;
        times,
        nino3,
        nino34,
        basin,
        Tsave,
        hsave,
        x = grid.x,
        y = grid.y)

    return s, grid, p
end

function plot_timeseries(output_file="zebiak_cane_1987.jld2";
                         figfile="zebiak_cane_timeseries.png")

    data = load(output_file)

    times = data["times"]
    nino3 = data["nino3"]
    nino34 = data["nino34"]
    basin = data["basin"]

    fig = Figure(size=(950, 520))

    ax = Axis(fig[1, 1],
        xlabel = "Time (years)",
        ylabel = "SST anomaly (°C)",
        title = "Zebiak–Cane-style coupled model")

    lines!(ax, times, nino3, linewidth=2, label="NINO3-like")
    lines!(ax, times, nino34, linewidth=2, label="NINO3.4-like")
    lines!(ax, times, basin, linewidth=2, label="Basin mean")

    hlines!(ax, [0], linestyle=:dash, linewidth=1)
    axislegend(ax, position=:rb)

    save(figfile, fig)

    return fig
end

function plot_last_sst(output_file="zebiak_cane_1987.jld2";
                       figfile="zebiak_cane_last_sst.png")

    data = load(output_file)

    x = data["x"]
    y = data["y"]
    T = data["Tsave"][end]

    fig = Figure(size=(850, 420))

    ax = Axis(fig[1, 1],
        xlabel = "x (m)",
        ylabel = "y (m)",
        title = "Final SST anomaly")

    hm = heatmap!(ax, x, y, T)
    Colorbar(fig[1, 2], hm, label="°C")

    save(figfile, fig)

    return fig
end

function run_and_plot()
    s, grid, p = run_model(
        stop_time = 5year,
        dt = 0.05day,
        output_interval = 30day,
        output_file = "zebiak_cane_1987.jld2"
    )

    fig1 = plot_timeseries("zebiak_cane_1987.jld2";
                           figfile="zebiak_cane_timeseries.png")

    fig2 = plot_last_sst("zebiak_cane_1987.jld2";
                         figfile="zebiak_cane_last_sst.png")

    return s, grid, p, fig1, fig2
end

end

using .ZebiakCane1987

s, grid, p, fig1, fig2 = ZebiakCane1987.run_and_plot()